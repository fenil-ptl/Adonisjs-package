{
  "compilerOptions": {
    /* Output */
    "rootDir": "./src",
    "outDir": "./build",

    /* Module */
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2020",

    /* Types */
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,

    /* Interop */
    "esModuleInterop": true,

    /* Strictness */
    "strict": true,

    /* Debug */
    "sourceMap": true,

    /* Performance */
    "skipLibCheck": true
  },

  "include": ["src","contracts"],
}
